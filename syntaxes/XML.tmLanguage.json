{
  "fileTypes": [],
  "injectionSelector": "L:text.xml -comment -(string - meta.embedded)",
  "patterns": [
    {
      "include": "#xml-cdata-javascript"
    },
    {
      "include": "#xml-cdata-glsl"
    }
  ],
  "scopeName": "xml.cdata.languages.x3d",
  "repository": {
    "xml-cdata-javascript": {
      "contentName": "source.js",
      "begin": "<!\\[CDATA\\[\\s*(?:(?:ecmascript|javascript|vrmlscript):|data:(?:text|application)/javascript,)",
      "beginCaptures": {
        "0": {
          "name": "comment.block.xml"
        }
      },
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "comment.block.xml"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        },
        {
          "comment": "if it is not source.js it is something else",
          "match": "."
        }
      ]
    },
    "xml-cdata-glsl": {
      "contentName": "source.glsl",
      "begin": "<!\\[CDATA\\[\\s*data:x-shader/x-(?:vertex|fragment),",
      "beginCaptures": {
        "0": {
          "name": "comment.block.xml"
        }
      },
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "comment.block.xml"
        }
      },
      "patterns": [
        {
          "include": "source.glsl"
        },
        {
          "comment": "if it is not source.glsl it is something else",
          "match": "."
        }
      ]
    }
  }
}
