{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "X3DV",
  "scopeName": "source.x3dv",
  "fileTypes": ["x3dv", "wrl", "vrml"],
  "patterns": [
    {
      "include": "#blockComment"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#javascript-strings"
    },
    {
      "include": "#glsl-strings"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "comment": "headers",
          "name": "comment.line.x3dv",
          "match": "^#(?:X3D|VRML) V\\d+\\.\\d+ utf8\\s+.*?$"
        },
        {
          "comment": "single-line comments",
          "name": "comment.line.x3dv",
          "match": "#.+$"
        },
        {
          "comment": "PROFILE statement",
          "match": "\\b(PROFILE)\\s+(CADInterchange|Core|Full|Immersive|Interactive|Interchange|MedicalInterchange|MPEG4Interactive)\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "constant.language.x3dv" }
          }
        },
        {
          "comment": "COMPONENT statements",
          "match": "\\b(COMPONENT)\\s+(CADGeometry|Core|CubeMapTexturing|DIS|EnvironmentalEffects|EnvironmentalSensor|EventUtilities|Followers|Geometry2D|Geometry3D|Geospatial|Grouping|HAnim|Interpolation|KeyDeviceSensor|Layering|Layout|Lighting|NURBS|Navigation|Networking|ParticleSystems|Picking|PointingDeviceSensor|Rendering|RigidBodyPhysics|Scripting|Shaders|Shape|Sound|Text|TextureProjection|Texturing|Texturing3D|Time|VolumeRendering)\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "constant.language.x3dv" }
          }
        },
        {
          "comment": "UNIT statements",
          "match": "\\b(UNIT)\\s+(angle|force|length|mass)\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "constant.language.x3dv" }
          }
        },
        {
          "comment": "PROTO statements",
          "match": "\\b(EXTERNPROTO|PROTO)\\s+([^\\x30-\\x39\\x00-\\x20\\x22\\x23\\x27\\x2b\\x2c\\x2d\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]{1}[^\\x00-\\x20\\x22\\x23\\x27\\x2c\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "support.class.x3dv" }
          }
        },
        {
          "comment": "DEF, USE, ROUTE, TO, EXPORT, IMPORT, AS statements",
          "match": "\\b(DEF|USE|ROUTE|TO|EXPORT|IMPORT|AS)\\s+([^\\x30-\\x39\\x00-\\x20\\x22\\x23\\x27\\x2b\\x2c\\x2d\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]{1}[^\\x00-\\x20\\x22\\x23\\x27\\x2c\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "constant.language.x3dv" }
          }
        },
        {
          "comment": "keywords",
          "name": "keyword.control.x3dv",
          "match": "\\b(PROFILE|COMPONENT|UNIT|META|EXTERNPROTO|PROTO|IS|DEF|USE|ROUTE|TO|IMPORT|EXPORT|AS|DESCRIPTION)\\b"
        },
        {
          "comment": "constants",
          "name": "constant.language.x3dv",
          "match": "\\b(TRUE|FALSE|NULL)\\b"
        },
        {
          "comment": "access types and field types",
          "match": "\\b(initializeOnly|inputOutput|inputOnly|outputOnly|field|eventIn|eventOut|exposedField)\\s+([SM]F(?:Bool|Color(?:RGBA)?|Double|Float|Image|Int32|Matrix[34][df]|Node|Rotation|String|Time|Vec[234][df]))\\b",
          "captures": {
            "1": { "name": "keyword.control.x3dv" },
            "2": { "name": "support.class.x3dv" }
          }
        },
        {
          "comment": "node type names",
          "match": "\\b([^\\x30-\\x39\\x00-\\x20\\x22\\x23\\x27\\x2b\\x2c\\x2d\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]{1}[^\\x00-\\x20\\x22\\x23\\x27\\x2c\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]*)\\s*{",
          "captures": {
            "1": { "name": "support.class.x3dv" }
          }
        },
        {
          "comment": "hex and floating-point numbers",
          "name": "constant.numeric.x3dv",
          "match": "\\b(?:0[xX][\\da-fA-F]+|[+-]?(?:(?:(?:\\d*\\.\\d+)|(?:\\d+(?:\\.)?))(?:[eE][+-]?\\d+)?))\\b"
        },
        {
          "name": "punctuation.separator.x3dv",
          "match": "[:\\.,]"
        },
        {
          "comment": "rest of uncolored words (field and node names)",
          "name": "variable.other.readwrite.x3dv",
          "match": "([^\\x30-\\x39\\x00-\\x20\\x22\\x23\\x27\\x2b\\x2c\\x2d\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]{1}[^\\x00-\\x20\\x22\\x23\\x27\\x2c\\x2e\\x5b\\x5c\\x5d\\x7b\\x7d\\x7f]*)"
        }
      ]
    },
    "blockComment": {
      "name": "comment.block.x3dv",
      "begin": "#\\/\\*",
      "end": "\\*\\/#",
      "beginCaptures": {
        "0": {
          "name": "comment.block.begin.x3dv"
        }
      },
      "endCaptures": {
        "0": {
          "name": "comment.block.end.x3dv"
        }
      }
    },
    "javascript-strings": {
      "include": "source.js",
      "contentName": "source.js",
      "begin": "\"((?:ecmascript|javascript|vrmlscript):|data:(?:text|application)/javascript,)",
      "beginCaptures": {
        "0": {
          "name": "string.quoted.double.x3dv"
        },
        "1": {
          "name": "comment.line.x3dv"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.x3dv"
        }
      },
      "patterns": [
        {
          "name": "string.quoted.double.x3dv",
          "match": "(?<!\\\\)\\\\\".*?(?<!\\\\)\\\\\""
        },
        {
          "name": "constant.language.escape.x3dv",
          "match": "\\\\."
        },
        {
          "match": "([^\\\\\"]+)",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "source.js"
                }
              ]
            }
          }
        }
      ]
    },
    "glsl-strings": {
      "include": "source.glsl",
      "contentName": "source.glsl",
      "begin": "\"(data:x-shader/(?:x-vertex|x-fragment),)",
      "beginCaptures": {
        "0": {
          "name": "string.quoted.double.x3dv"
        },
        "1": {
          "name": "comment.line.x3dv"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.x3dv"
        }
      },
      "patterns": [
        {
          "name": "constant.language.escape.x3dv",
          "match": "\\\\."
        },
        {
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "source.glsl"
                }
              ]
            }
          },
          "match": "([^\\\\\"]+)"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.x3dv",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.language.escape.x3dv",
          "match": "\\\\."
        }
      ]
    }
  }
}
