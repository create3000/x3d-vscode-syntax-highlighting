<![CDATA[ecmascript:
function initialize ()
{
  const p = [ ];

  for (const { name } of Browser .supportedProfiles)
    p .push (name);

  console .log (p .sort () .join ('|'));

  const c = [ ];

  for (const { name } of Browser .supportedComponents)
    c .push (name);

  console .log (c .sort () .join ('|'));

  // Test string in string.
  print ("a image:", image);
  print ("some integers:", ints);

  print ("foo", image, "foo \"string in string\" ");
  print ("foo \\ \"string in string\" bah", image);
  print (SFColor .fromString (/* css */ `rgb(50, 100, 200)`), 'foo');

  // Test parentheses.
  foo (bah (bas ()));
}

const foo = bah = bas = () => { };
]]>
