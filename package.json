{
  "name": "x3d-vscode-syntax-highlighting",
  "publisher": "create3000",
  "displayName": "X3D Syntax Highlighting for VS Code",
  "description": "Provides Syntax Highlighting for All X3D Encodings and VRML 2.0 Files in VS Code",
  "version": "1.3.7",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/create3000/x3d-vscode-syntax-highlighting",
  "author": {
    "name": "Holger Seelig",
    "email": "holger.seelig@gmail.com",
    "url": "https://github.com/create3000"
  },
  "contributors": [
    {
      "name": "Holger Seelig",
      "email": "holger.seelig@gmail.com",
      "url": "https://github.com/create3000"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/create3000/x3d-vscode-syntax-highlighting.git"
  },
  "bugs": {
    "url": "https://github.com/create3000/x3d-vscode-syntax-highlighting/issues"
  },
  "keywords": [
    "3D",
    "JSON",
    "syntax highlighting",
    "tools",
    "VRML",
    "WRL",
    "X3D",
    "X3DJ",
    "X3DV"
  ],
  "galleryBanner": {
    "color": "#383838",
    "theme": "dark"
  },
  "sponsor": {
    "url": "https://www.patreon.com/X_ITE"
  },
  "scripts": {
    "release": "node build/release.js",
    "snippets": "node build/snippets.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "shell-tools": "^1.1.9",
    "x_ite-node": "^2.0.34"
  },
  "extensionPack": [
    "create3000.x-ite-vscode",
    "create3000.x-ite-vscode-formatter"
  ],
  "engines": {
    "vscode": "^1.14.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "x3dv",
        "aliases": [
          "X3DV",
          "VRML",
          "vrml"
        ],
        "extensions": [
          ".x3dv",
          ".wrl",
          ".vrml"
        ],
        "configuration": "./x3dv.language-configuration.json",
        "firstLine": "#(VRML|X3D) V(.*?) (utf8)\\b"
      },
      {
        "id": "xml",
        "extensions": [
          ".x3d"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".x3dj"
        ]
      }
    ],
    "snippets": [
      {
        "language": "x3dv",
        "path": "./snippets/x3dv.json"
      }
    ],
    "grammars": [
      {
        "language": "x3dv",
        "scopeName": "source.x3dv",
        "path": "./syntaxes/x3dv.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.glsl": "glsl"
        }
      },
      {
        "injectTo": [
          "text.xml",
          "text.html"
        ],
        "scopeName": "xml.cdata.languages.x3d",
        "path": "./syntaxes/xml.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.glsl": "glsl"
        }
      },
      {
        "injectTo": [
          "text.html"
        ],
        "scopeName": "html.script.fields.x3d",
        "path": "./syntaxes/html.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.xml": "xml"
        }
      },
      {
        "injectTo": [
          "text.html.markdown"
        ],
        "scopeName": "markdown.embedded.x3d",
        "path": "./syntaxes/markdown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.x3dv": "x3dv"
        }
      }
    ]
  },
  "allowScripts": {
    "skia-canvas@3.0.8": true
  }
}
